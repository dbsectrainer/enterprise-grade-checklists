{
  "name": "enterprise-grade-checklists",
  "version": "2.1.1",
  "description": "A comprehensive collection of enterprise-grade checklists for various development aspects",
  "type": "module",
  "main": "index.html",
  "homepage": "https://dbsectrainer.github.io/enterprise-grade-checklists/",
  "scripts": {
    "serve": "http-server . -p 3000",
    "build": "node scripts/build.mjs",
    "verify:dist": "node scripts/verify-dist.mjs",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{html,css,js,mjs,json,md}\"",
    "format:check": "prettier --check .",
    "validate:html": "html-validate index.html validator.html \"enterprise-*-checklist/index.html\"",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "node --test tests/unit/markup.test.js tests/unit/validator-utils.test.js",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "capture": "node scripts/capture-evidence.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dbsectrainer/enterprise-grade-checklists.git"
  },
  "bugs": {
    "url": "https://github.com/dbsectrainer/enterprise-grade-checklists/issues"
  },
  "keywords": [
    "enterprise",
    "checklist",
    "best-practices",
    "compliance",
    "accessibility",
    "development",
    "devops",
    "security",
    "frontend",
    "backend",
    "cloud",
    "mobile",
    "ai-ml"
  ],
  "author": "Enterprise Checklist Contributors",
  "license": "MIT",
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "1.64.1",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "html-validate": "^10.4.0",
    "http-server": "^14.1.1",
    "prettier": "^3.6.2"
  },
  "engines": {
    "node": ">=26.13.0"
  }
}
